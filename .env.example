# OpenAI API Key for DALL-E image generation
OPENAI_API_KEY=your_openai_api_key_here

# Database URL (if using PostgreSQL)
DATABASE_URL=your_database_url_here

# Optional: Publer API credentials for auto-scheduling
PUBLER_API_KEY=your_publer_api_key_here

# Optional: Buffer API credentials for auto-scheduling
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here

# Optional: Google Sheets API credentials
GOOGLE_SHEETS_CLIENT_ID=your_google_client_id_here
GOOGLE_SHEETS_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_SHEETS_REDIRECT_URI=your_redirect_uri_here
